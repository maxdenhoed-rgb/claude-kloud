# Reject any staged .env* file other than .env.example. Per REQ-12.6.
staged_env_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.)' | grep -v '^\.env\.example$' || true)
if [ -n "$staged_env_files" ]; then
  echo "Refusing commit: env files other than .env.example are staged:"
  echo "$staged_env_files"
  echo "Unstage them and add to .gitignore."
  exit 1
fi

pnpm lint-staged
