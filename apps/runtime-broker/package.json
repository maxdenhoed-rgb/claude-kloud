{
  "name": "@claudekloud/runtime-broker",
  "version": "0.0.1",
  "private": true,
  "description": "Local runtime broker: boots lab containers, mints session tokens, proxies WebSocket PTY",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@claudekloud/session-token": "workspace:*",
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.3",
    "dockerode": "4.0.4",
    "hono": "4.6.20",
    "pino": "9.5.0",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.38",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
