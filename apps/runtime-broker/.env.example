# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Port the broker listens on (HTTP + WS on the same server)
BROKER_PORT=3001

# URL of the proxy's internal listener — must match INTERNAL_PORT in apps/proxy/.env.local
PROXY_INTERNAL_URL=http://localhost:8081

# Shared secret for proxy /internal/* endpoints.
# MUST be identical to INTERNAL_WEBHOOK_SECRET in apps/proxy/.env.local.
INTERNAL_WEBHOOK_SECRET=change-me-to-a-random-32-char-secret

# JWT signing secret.
# MUST be identical to SESSION_SIGNING_SECRET in apps/proxy/.env.local.
# The broker does not sign tokens itself but the value must be documented for parity.
SESSION_SIGNING_SECRET=change-me-to-a-random-32-char-secret

# Base URL injected into lab containers as ANTHROPIC_BASE_URL.
# host.docker.internal resolves to the host on Docker Desktop and on Linux (with ExtraHosts).
ANTHROPIC_PROXY_BASE_URL=http://host.docker.internal:8080

# Docker image to boot for lab containers (must be pre-built locally)
LAB_IMAGE=lab-base:local

# Idle timeout in milliseconds before a container is reaped (default 20 min)
IDLE_TIMEOUT_MS=1200000

# Optional — override if Docker daemon is not at the default socket path
# DOCKER_HOST=unix:///var/run/docker.sock

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug
NODE_ENV=development
