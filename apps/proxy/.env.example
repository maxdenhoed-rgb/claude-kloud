# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

ANTHROPIC_API_KEY=sk-ant-your-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/claudekloud
SESSION_SIGNING_SECRET=change-me-to-a-random-32-char-secret
INTERNAL_WEBHOOK_SECRET=change-me-to-a-random-secret

# Optional
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=claudekloud-proxy
LOG_LEVEL=debug
NODE_ENV=development

# Port configuration (two-listener model)
# PUBLIC_PORT   — serves /healthz, /readyz, /v1/* (default: 8080)
# INTERNAL_PORT — serves /internal/* on the Fly private network only (default: 8081)
# PORT is a legacy alias for PUBLIC_PORT; PUBLIC_PORT takes precedence when both are set.
PUBLIC_PORT=8080
INTERNAL_PORT=8081
